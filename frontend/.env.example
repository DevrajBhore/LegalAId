# Frontend build-time configuration (Vite).
# IMPORTANT: Vite inlines these at BUILD time — after changing this value you
# must rebuild/redeploy the frontend (e.g. redeploy on Vercel). Setting it only
# at runtime has no effect.

# Base URL of the LegalAId backend API (no trailing slash).
# Local dev:   http://localhost:5000
# Production:  https://<your-backend>.onrender.com
VITE_API_BASE_URL=http://localhost:5000
