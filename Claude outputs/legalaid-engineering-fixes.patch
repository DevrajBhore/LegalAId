index 000000000..f8f2f3d2f
--- /dev/null
+++ b/tests/originPolicy.test.mjs
@@ -0,0 +1,75 @@
+/**
+ * originPolicy.test.mjs — CREDENTIALED CORS FAILS CLOSED; COOKIE CSRF IS CHECKED;
+ * ANY CONFIGURED AI PROVIDER IS DETECTED
+ *
+ * 1. Without CLIENT_URL the backend used to reflect every request origin with
+ *    credentials enabled. Production now requires CLIENT_URL; development
+ *    without it allows loopback only.
+ * 2. A cookie-authenticated, state-changing request from a foreign origin is
+ *    refused (the production cookie is SameSite=None).
+ * 3. hasSemanticProviderConfigured checked only GEMINI/GROQ keys; an
+ *    OpenAI-only configuration never entered semantic drafting.
+ */
+import assert from "node:assert/strict";
+import {
+  isOriginAllowed,
+  isCrossSiteCookieRequest,
+  isProductionEnv,
+} from "../backend/auth/originPolicy.js";
+
+let checks = 0;
+const ok = (cond, msg) => {
+  assert.ok(cond, msg);
+  checks += 1;
+  console.log(`PASS  ${msg}`);
+};
+
+const prod = { NODE_ENV: "production", CLIENT_URL: "https://legalaid.example/, https://www.legalaid.example" };
+const prodNoClient = { NODE_ENV: "production" };
+const renderNoClient = { RENDER: "true" };
+const dev = {};
+
+/* ── Origin allowlist ───────────────────────────────────────────────────── */
+ok(isOriginAllowed("https://legalaid.example", prod), "configured origin is allowed (trailing slash normalized)");
+ok(isOriginAllowed("https://WWW.legalaid.example", prod), "configured origins match case-insensitively");
+ok(!isOriginAllowed("https://evil.example", prod), "unlisted origin is refused in production");
+ok(!isOriginAllowed("https://evil.example", prodNoClient), "production without CLIENT_URL refuses foreign origins");
+ok(!isOriginAllowed("http://localhost:5173", prodNoClient), "production without CLIENT_URL does not fall back to loopback");
+ok(isProductionEnv(renderNoClient), "running on Render counts as production");
+ok(isOriginAllowed("http://localhost:5173", dev), "development without CLIENT_URL allows localhost");
+ok(isOriginAllowed("http://127.0.0.1:3000", dev), "development without CLIENT_URL allows 127.0.0.1");
+ok(!isOriginAllowed("https://evil.example", dev), "development without CLIENT_URL refuses non-loopback origins");
+ok(!isOriginAllowed("http://localhost.evil.example", dev), "loopback match is exact, not a prefix");
+
+/* ── Cookie CSRF guard ──────────────────────────────────────────────────── */
+const req = (method, headers = {}) => ({ method, headers: { host: "api.legalaid.example", ...headers } });
+ok(!isCrossSiteCookieRequest(req("GET", { origin: "https://evil.example" }), prod), "safe methods are not CSRF-checked");
+ok(isCrossSiteCookieRequest(req("POST", { origin: "https://evil.example" }), prod), "cross-site cookie POST is refused");
+ok(isCrossSiteCookieRequest(req("DELETE", { referer: "https://evil.example/page" }), prod), "cross-site DELETE identified by Referer is refused");
+ok(isCrossSiteCookieRequest(req("POST", { origin: "null" }), prod), "opaque (null) origin is refused");
+ok(!isCrossSiteCookieRequest(req("POST", { origin: "https://legalaid.example" }), prod), "allowed-origin cookie POST passes");
+ok(!isCrossSiteCookieRequest(req("POST", { origin: "https://api.legalaid.example" }), prod), "same-host POST passes");
+ok(!isCrossSiteCookieRequest(req("POST"), prod), "a request with no Origin or Referer (not a browser page) passes");
+
+/* ── Provider detection ─────────────────────────────────────────────────── */
+const saved = { ...process.env };
+// Blank rather than delete: backend/loadEnv.js runs dotenv on import, which
+// fills in variables that are absent but never overrides ones already set.
+for (const key of ["GEMINI_API_KEY", "GROQ_API_KEY", "OPENAI_API_KEY", "AI_PROVIDER", "AI_FALLBACK_PROVIDER"]) {
+  process.env[key] = "";
+}
+const { hasConfiguredProvider, getProviderChain } = await import("../backend/ai/providers.js");
+try {
+  ok(!hasConfiguredProvider(), "no keys: no provider configured");
+  process.env.OPENAI_API_KEY = "test-key";
+  ok(hasConfiguredProvider(), "OpenAI-only configuration counts as a configured provider");
+  ok(getProviderChain()[0].name === "openai",
+    "OpenAI-only configuration routes calls to OpenAI even with the default primary unset");
+  process.env.GEMINI_API_KEY = "test-key";
+  ok(getProviderChain()[0].name === "gemini", "a configured primary still takes precedence");
+} finally {
+  for (const key of Object.keys(process.env)) if (!(key in saved)) delete process.env[key];
+  Object.assign(process.env, saved);
+}
+
+console.log(`\nALL GREEN (${checks} checks)`);
diff --git a/tests/reviewOverlayPersistence.test.mjs b/tests/reviewOverlayPersistence.test.mjs
new file mode 100644
index 000000000..fc135b17f
--- /dev/null
+++ b/tests/reviewOverlayPersistence.test.mjs
@@ -0,0 +1,122 @@
+/**
+ * reviewOverlayPersistence.test.mjs — A REVIEW DECISION IS DURABLE OR REFUSED
+ *
+ * The overlay used to update its in-memory map before the database write and
+ * keep the change even when that write failed, so one process could serve a
+ * sign-off that would vanish on restart. A reset deleted the stored row, which
+ * let a sign-off still present in the deployed files reappear after a restart.
+ *
+ * Runs offline: ReviewSignoff is swapped for an in-memory stand-in whose
+ * connection state and failures the test controls.
+ */
+import assert from "node:assert/strict";
+import { register } from "node:module";
+
+const fake = `
+const rows = new Map();
+export const control = { readyState: 1, failWrites: false, failReads: false };
+const key = (f) => f.kind + "|" + f.targetId;
+export default {
+  get db() { return { readyState: control.readyState }; },
+  _rows: rows,
+  find() {
+    return { lean: async () => { if (control.failReads) throw new Error("read failed"); return [...rows.values()].map((r) => structuredClone(r)); } };
+  },
+  async findOneAndUpdate(filter, update) {
+    if (control.failWrites) throw new Error("write failed");
+    rows.set(key(filter), structuredClone(update));
+    return update;
+  },
+  async deleteOne(filter) {
+    if (control.failWrites) throw new Error("write failed");
+    rows.delete(key(filter));
+  },
+};`;
+const FAKE_URL = "data:text/javascript," + encodeURIComponent(fake);
+register("data:text/javascript," + encodeURIComponent(`
+export async function resolve(specifier, context, next) {
+  if (/\\/models\\/ReviewSignoff\\.js$/.test(specifier)) return { url: ${JSON.stringify(FAKE_URL)}, shortCircuit: true };
+  return next(specifier, context);
+}`));
+
+const { control, default: ReviewSignoff } = await import(FAKE_URL);
+const overlay = await import("../backend/services/reviewOverlay.js");
+const { saveOverlay, overlayFor, applyOverlay, hydrateReviewOverlay, reviewOverlayStatus, reviewPersistenceRequired, OVERLAY_KIND } = overlay;
+
+let checks = 0;
+const ok = (cond, msg) => {
+  assert.ok(cond, msg);
+  checks += 1;
+  console.log(`PASS  ${msg}`);
+};
+const rejects503 = async (promise, msg) => {
+  await assert.rejects(promise, (err) => err.statusCode === 503);
+  checks += 1;
+  console.log(`PASS  ${msg}`);
+};
+
+const saved = { MONGODB_URI: process.env.MONGODB_URI, NODE_ENV: process.env.NODE_ENV, RENDER: process.env.RENDER };
+process.env.MONGODB_URI = "mongodb://example/test";
+process.env.NODE_ENV = "";
+process.env.RENDER = "";
+const C = OVERLAY_KIND.CLAUSE;
+
+try {
+  ok(reviewPersistenceRequired(), "a configured database makes durable review state required");
+
+  /* ── Success: persisted, then published ─────────────────────────────── */
+  const approved = { review_status: "approved", reviewed_by: "Adv. A" };
+  const result = await saveOverlay(C, "CL_1", approved, "Adv. A");
+  ok(result.persisted === true && overlayFor(C, "CL_1")?.reviewed_by === "Adv. A",
+    "a successful write is persisted and then visible");
+
+  /* ── Failed write: refused, nothing changes ─────────────────────────── */
+  control.failWrites = true;
+  await rejects503(saveOverlay(C, "CL_1", { review_status: "draft", reviewed_by: null }, "Adv. B"),
+    "a failed database write is refused with 503");
+  ok(overlayFor(C, "CL_1")?.reviewed_by === "Adv. A", "a refused write leaves the served decision unchanged");
+  ok(reviewOverlayStatus().ready === false, "after a failed write the overlay reports not ready");
+  control.failWrites = false;
+
+  /* ── Disconnected: refused where durability is required ─────────────── */
+  control.readyState = 0;
+  await rejects503(saveOverlay(C, "CL_2", approved, "Adv. A"), "a write with the database disconnected is refused");
+  ok(overlayFor(C, "CL_2") === null, "a refused write is not held in memory");
+  control.readyState = 1;
+
+  /* ── Reset is stored as nulls, so the file cannot resurrect it ──────── */
+  await saveOverlay(C, "CL_1", { review_status: "draft", reviewed_by: null, reviewed_on: null }, "Adv. A");
+  const fromFile = applyOverlay(C, "CL_1", { review_status: "approved", reviewed_by: "Old Reviewer", reviewed_on: "2026-01-01" });
+  ok(fromFile.review_status === "draft" && !("reviewed_by" in fromFile) && !("reviewed_on" in fromFile),
+    "a withdrawal overrides a sign-off still present in the files");
+  ok(ReviewSignoff._rows.has(`${C}|CL_1`), "the withdrawal is kept as a stored row, not deleted");
+
+  /* ── Hydration rebuilds, so other instances' withdrawals propagate ──── */
+  ReviewSignoff._rows.delete(`${C}|CL_1`);
+  ReviewSignoff._rows.set(`${C}|CL_3`, { kind: C, targetId: "CL_3", payload: { review_status: "approved" } });
+  const refreshed = await hydrateReviewOverlay();
+  ok(refreshed.changed === true && overlayFor(C, "CL_1") === null && overlayFor(C, "CL_3")?.review_status === "approved",
+    "refreshing replaces memory with the database state (adds and removals)");
+  ok((await hydrateReviewOverlay()).changed === false, "an unchanged database reports no change");
+  ok(reviewOverlayStatus().ready === true, "a healthy refresh reports ready");
+
+  control.failReads = true;
+  const failedRefresh = await hydrateReviewOverlay();
+  ok(failedRefresh.available === false && overlayFor(C, "CL_3")?.review_status === "approved",
+    "a failed refresh keeps serving the last good state and reports unavailable");
+  control.failReads = false;
+
+  /* ── Development without a database keeps the old file-only behaviour ─ */
+  process.env.MONGODB_URI = "";
+  control.readyState = 0;
+  const dev = await saveOverlay(C, "CL_DEV", approved, "Dev");
+  ok(dev.persisted === false && overlayFor(C, "CL_DEV")?.review_status === "approved",
+    "with no database configured (development) decisions stay local, as before");
+} finally {
+  for (const [k, v] of Object.entries(saved)) {
+    if (v === undefined) delete process.env[k];
+    else process.env[k] = v;
+  }
+}
+
+console.log(`\nALL GREEN (${checks} checks)`);
diff --git a/tests/statutoryFailureVisible.test.mjs b/tests/statutoryFailureVisible.test.mjs
new file mode 100644
index 000000000..b40e39311
--- /dev/null
+++ b/tests/statutoryFailureVisible.test.mjs
@@ -0,0 +1,91 @@
+/**
+ * statutoryFailureVisible.test.mjs — A STATUTORY LAYER THAT DID NOT RUN MUST SAY SO
+ *
+ * runStatutoryValidation used to catch every exception, log it, and return
+ * whatever issues had accumulated. A failure before the first finding therefore
+ * returned an empty list: indistinguishable from "checked against the mapped
+ * statutes and found nothing".
+ *
+ * It now reports context.status ("completed" | "failed") and, on failure, a
+ * STATUTORY_CHECK_UNAVAILABLE finding. The engine carries the status into
+ * _layers, and the validation coverage lists the layer as run or skipped.
+ */
+import assert from "node:assert/strict";
+import {
+  runStatutoryValidation,
+  statutoryCheckUnavailableIssue,
+} from "../IRE/src/statutes/statutoryEngine.js";
+import { runDocumentValidation } from "../backend/services/validationService.js";
+
+let checks = 0;
+const ok = (cond, msg) => {
+  assert.ok(cond, msg);
+  checks += 1;
+  console.log(`PASS  ${msg}`);
+};
+
+/* ── 1. A throw inside the layer is reported, not swallowed ─────────────── */
+const originalError = console.error;
+console.error = () => {}; // the engine logs the failure; keep test output clean
+let failed;
+try {
+  failed = await runStatutoryValidation(null);
+} finally {
+  console.error = originalError;
+}
+ok(failed.context.status === "failed", "a throwing statutory run reports status=failed");
+ok(typeof failed.context.error === "string" && failed.context.error.length > 0,
+  "the failure carries its error message");
+const unavailable = failed.issues.find((i) => i.rule_id === "STATUTORY_CHECK_UNAVAILABLE");
+ok(Boolean(unavailable), "a failed run emits STATUTORY_CHECK_UNAVAILABLE instead of an empty list");
+ok(unavailable.severity === "HIGH" && unavailable.blocks_generation === false,
+  "the unavailable finding is HIGH but does not block by itself");
+ok(unavailable.manual_review_required === true && unavailable.notice_only !== true,
+  "the unavailable finding is actionable (counts against 'checks passed'), not a notice");
+
+/* ── 2. The issue factory never throws on odd input ─────────────────────── */
+ok(statutoryCheckUnavailableIssue(undefined).rule_id === "STATUTORY_CHECK_UNAVAILABLE",
+  "the unavailable finding can be built without an error object");
+
+/* ── 3. A normal run is unchanged ───────────────────────────────────────── */
+// Clean output must stay byte-identical (provenanceConservation), so a
+// completed run carries no status field and adds nothing to coverage.
+const draft = {
+  document_type: "NDA",
+  clauses: [
+    {
+      clause_id: "NDA_TEST_CONFIDENTIALITY",
+      category: "CONFIDENTIALITY",
+      title: "Confidentiality",
+      text: "The Receiving Party shall keep the Confidential Information confidential.",
+    },
+  ],
+  metadata: {},
+};
+const completed = await runStatutoryValidation(draft);
+ok(completed.context.status !== "failed" &&
+   !completed.issues.some((i) => i.rule_id === "STATUTORY_CHECK_UNAVAILABLE"),
+  "a normal statutory run is not reported as failed");
+
+const finalRun = await runDocumentValidation(draft, { mode: "final", documentType: "NDA" });
+ok(finalRun.layers?.statutory_status === undefined,
+  "a completed run adds no statutory_status to the layers");
+ok(!finalRun.coverage?.layers_skipped?.some((s) => s.layer === "statutory_kb"),
+  "a completed run is not listed as skipped");
+
+/* ── 4. A failure reaches coverage and the release outcome ─────────────── */
+// Drive formatValidationResult the way runDocumentValidation does after the
+// engine reports a failed statutory layer.
+const { formatValidationResult } = await import("../backend/services/validationService.js");
+const formatted = formatValidationResult({
+  mode: "final",
+  issues: [statutoryCheckUnavailableIssue(new Error("boom"))],
+  layers: { statutory_status: "failed", statutory_error: "boom" },
+  coverage: { layers_run: ["rule_engine"], layers_skipped: [{ layer: "statutory_kb", reason: "failed to complete: boom", failed: true }] },
+});
+ok(formatted.checks_passed === false && formatted.certified === false,
+  "a failed statutory layer means checks did NOT pass");
+ok(formatted.blockingIssues.length === 0 && formatted.advisoryIssues.some((i) => i.rule_id === "STATUTORY_CHECK_UNAVAILABLE"),
+  "the failure is advisory, not blocking");
+
+console.log(`\nALL GREEN (${checks} checks)`);
