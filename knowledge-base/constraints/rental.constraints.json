{
  "domain": "rental",
  "rules": [
    {
      "rule_id": "RENTAL_REQUIRES_PROPERTY_DESCRIPTION",
      "severity": "CRITICAL",
      "description": "Rental agreement must include a description of the leased premises.",
      "statutory_reference": "Transfer of Property Act 1882 – S.105",
      "fails_if": [
        "RENTAL_PROPERTY_DESCRIPTION_001"
      ]
    },
    {
      "rule_id": "RENTAL_REQUIRES_RENT_PAYMENT",
      "severity": "CRITICAL",
      "description": "Rental agreement must specify rent amount, due date, and payment method.",
      "statutory_reference": "Transfer of Property Act 1882 – S.105",
      "fails_if": [
        "RENTAL_RENT_PAYMENT_001"
      ]
    },
    {
      "rule_id": "RENTAL_REQUIRES_SECURITY_DEPOSIT",
      "severity": "HIGH",
      "description": "Rental agreement should specify security deposit amount and refund conditions.",
      "statutory_reference": "Model Tenancy Act 2021 – S.11",
      "fails_if": [
        "RENTAL_SECURITY_DEPOSIT_001"
      ]
    },
    {
      "rule_id": "RENTAL_REQUIRES_TERM",
      "severity": "CRITICAL",
      "description": "Rental agreement must specify the lease term (start date and duration/end date).",
      "statutory_reference": "Transfer of Property Act 1882 – S.105",
      "fails_if": [
        "RENTAL_TERM_001"
      ]
    },
    {
      "rule_id": "RENTAL_REQUIRES_TERMINATION",
      "severity": "CRITICAL",
      "description": "Rental agreement must specify termination conditions and notice period.",
      "statutory_reference": "Transfer of Property Act 1882 – S.106",
      "fails_if": [
        "RENTAL_TERMINATION_001"
      ]
    },
    {
      "rule_id": "RENTAL_REGISTRATION_MANDATORY_OVER_12M",
      "severity": "CRITICAL",
      "description": "A lease or tenancy for a term of 12 months or more is compulsorily registrable; the instrument must address registration.",
      "statutory_reference": "Registration Act 1908 - S.17(1)(d); S.49; Transfer of Property Act 1882 - S.107",
      "when": [
        {
          "var": [
            "lease_term",
            "occupancy_term",
            "rental_term",
            "agreement_term"
          ],
          "op": "months_gte",
          "value": 12
        }
      ],
      "assert": [
        {
          "clause_present": [
            "PROP_REGISTRATION_MANDATORY_001",
            "PROP_REGISTRATION_001"
          ]
        }
      ],
      "remedy": "Include the compulsory-registration clause and record which party bears the registration fee and stamp duty.",
      "reviewed_by": "PENDING",
      "reviewed_on": null,
      "review_status": "draft-needs-legal-review"
    },
    {
      "rule_id": "RENTAL_SHORT_TERM_REGISTRATION_NOT_REQUIRED",
      "severity": "LOW",
      "description": "A tenancy of less than 12 months is not compulsorily registrable; a mandatory-registration clause overstates the requirement.",
      "statutory_reference": "Registration Act 1908 - S.17(1)(d) proviso",
      "applies_to_doc_types": [
        "RENTAL_AGREEMENT",
        "LEAVE_AND_LICENSE_AGREEMENT"
      ],
      "when": [
        {
          "var": [
            "lease_term",
            "occupancy_term",
            "rental_term",
            "agreement_term"
          ],
          "op": "months_lt",
          "value": 12
        }
      ],
      "assert": [
        {
          "clause_absent": [
            "PROP_REGISTRATION_MANDATORY_001"
          ]
        }
      ],
      "remedy": "Use the optional-registration clause for a sub-12-month tenancy.",
      "reviewed_by": "PENDING",
      "reviewed_on": null,
      "review_status": "draft-needs-legal-review"
    }
  ]
}
