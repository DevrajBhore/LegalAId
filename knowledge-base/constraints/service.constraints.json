{
  "domain": "service",
  "rules": [
    {
      "rule_id": "SERVICE_REQUIRES_SCOPE",
      "severity": "HIGH",
      "description": "Service agreement must define the scope of services.",
      "statutory_reference": "Indian Contract Act 1872 – S.29",
      "fails_if": [
        "SERVICE_SCOPE_001",
        "CORE_PURPOSE_001"
      ],
      "applies_to_doc_types": [
        "SERVICE_AGREEMENT",
        "CONSULTANCY_AGREEMENT",
        "INDEPENDENT_CONTRACTOR_AGREEMENT",
        "SOFTWARE_DEVELOPMENT_AGREEMENT"
      ]
    },
    {
      "rule_id": "SERVICE_REQUIRES_PAYMENT",
      "severity": "CRITICAL",
      "description": "Service agreement must specify payment terms.",
      "statutory_reference": "Indian Contract Act 1872 – S.10",
      "fails_if": [
        "SERVICE_PAYMENT_001",
        "CORE_TERM_001",
        "EMPLOYMENT_COMPENSATION_001"
      ],
      "applies_to_doc_types": [
        "SERVICE_AGREEMENT",
        "CONSULTANCY_AGREEMENT",
        "INDEPENDENT_CONTRACTOR_AGREEMENT",
        "SOFTWARE_DEVELOPMENT_AGREEMENT"
      ]
    },
    {
      "rule_id": "SERVICE_REQUIRES_TERM",
      "severity": "HIGH",
      "description": "Service agreement must specify contract term.",
      "fails_if": [
        "SERVICE_TERM_001",
        "CORE_TERM_001",
        "NDA_TERM_SURVIVAL_001",
        "RENTAL_TERM_001"
      ],
      "applies_to_doc_types": [
        "SERVICE_AGREEMENT",
        "CONSULTANCY_AGREEMENT",
        "INDEPENDENT_CONTRACTOR_AGREEMENT",
        "SOFTWARE_DEVELOPMENT_AGREEMENT"
      ]
    },
    {
      "rule_id": "SERVICE_REQUIRES_TERMINATION",
      "severity": "HIGH",
      "description": "Service agreement must include termination provisions.",
      "fails_if": [
        "SERVICE_TERMINATION_001",
        "CORE_TERMINATION_001",
        "EMPLOYMENT_TERMINATION_001",
        "RENTAL_TERMINATION_001"
      ],
      "applies_to_doc_types": [
        "SERVICE_AGREEMENT",
        "CONSULTANCY_AGREEMENT",
        "INDEPENDENT_CONTRACTOR_AGREEMENT",
        "SOFTWARE_DEVELOPMENT_AGREEMENT"
      ]
    },
    {
      "rule_id": "CONTRACTOR_REQUIRES_INDEPENDENT_STATUS",
      "severity": "HIGH",
      "description": "An independent contractor agreement must state that the relationship is principal-to-contractor and not employment, to avoid misclassification and consequent labour-law liability.",
      "statutory_reference": "Indian Contract Act 1872 – S.10; labour-law misclassification principles",
      "fails_if": ["CORE_RELATIONSHIP_OF_PARTIES_001"],
      "applies_to_doc_types": ["INDEPENDENT_CONTRACTOR_AGREEMENT"]
    },
    {
      "rule_id": "CONTRACTOR_REQUIRES_IP_ASSIGNMENT",
      "severity": "HIGH",
      "description": "An independent contractor agreement should address ownership/assignment of work-product intellectual property — absent assignment, the contractor may retain copyright as first author.",
      "statutory_reference": "Copyright Act 1957 – S.17",
      "fails_if": ["IP_ASSIGNMENT_001", "IP_OWNERSHIP_001", "IP_CONTRACTOR_RETAINS_001"],
      "applies_to_doc_types": ["INDEPENDENT_CONTRACTOR_AGREEMENT"]
    }
  ]
}
