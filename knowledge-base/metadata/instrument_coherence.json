{
  "//": [
    "D4.44. The lexicon the rendered-document coherence checks read. Universal: nothing here names a document type.",
    "The checks run only for a document type whose drafting policy declares rendering.instrument (today: TERM_SHEET). Every other type is unaffected, which is recorded as a coverage gap in knowledge-base/governance/term-sheet-rebuild.json, not hidden.",
    "These are checks on WORDING, not legal conclusions. Each finding says what the text does and why that matters; none of them decides whether a provision is enforceable."
  ],
  "contract_formation_formulae": [
    {
      "pattern": "intend(?:s)? to enter into a legally binding",
      "describes": "a recital that the parties intend a legally binding arrangement"
    },
    {
      "pattern": "in consideration of the mutual (?:covenants|promises)",
      "describes": "a consideration recital"
    },
    {
      "pattern": "receipt and sufficiency of which",
      "describes": "an acknowledgement of consideration"
    },
    {
      "pattern": "\\bagree as follows\\b",
      "describes": "an operative 'the Parties agree as follows'"
    },
    {
      "pattern": "\\bTHIS AGREEMENT\\b",
      "describes": "an opening that calls the document an agreement"
    },
    {
      "pattern": "\\bmade and executed\\b",
      "describes": "an execution formula"
    }
  ],
  "obligation_markers": [
    "\\bshall\\b",
    "\\bmust\\b",
    "\\bhereby\\b",
    "\\bundertakes? to\\b",
    "\\bagrees? to\\b",
    "\\bis obliged to\\b",
    "\\bis bound to\\b"
  ],
  "descriptive_frames": [
    "\\bit is proposed that\\b",
    "\\bpropose(?:s|d)? that\\b",
    "\\bthe Definitive Agreements (?:will|would|are to|are expected to|may) (?:provide|set out|require|include)\\b",
    "\\bas the Definitive Agreements will set out\\b",
    "\\bintend(?:s)? (?:these|that|for)\\b",
    "\\bwould\\b"
  ],
