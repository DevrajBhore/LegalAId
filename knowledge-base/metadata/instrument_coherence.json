  "articles_precedence": {
    "patterns": [
      "this (?:Agreement|Term Sheet) shall prevail[^.]{0,200}\\bArticles\\b",
      "\\bArticles\\b[^.]{0,200}this (?:Agreement|Term Sheet) shall prevail"
    ],
    "authority": "V.B. Rangaraj v. V.B. Gopalakrishnan, (1992) 1 SCC 160: a restriction on share transfer not contained in the Articles does not bind the company or its shareholders. Later decisions have qualified this, which is why it is a review finding and not a rule.",
    "outcome": "LEGAL_REVIEW_REQUIRED"
  },
  "cross_reference_patterns": [
    "\\bthe ([a-z][a-z ]{2,40}?) (?:listed|set out|specified|described) in this (?:Term Sheet|Agreement)\\b"
  ],
  "heading_reference_pattern": "provisions? headed ((?:\"[^\"]+\"(?:,\\s*|\\s+and\\s+)?)+)",
  "board_size": {
    "determinate": [
      "\\bboard of (\\w+)(?: \\(\\d+\\))? directors\\b",
      "\\b(\\w+) directors:"
    ],
    "indeterminate": [
      "such number of directors as (?:may be )?agreed"
    ]
  },
  "interpretive_constructions": [
    "shall have the meanings?",
    "shall be construed",
    "shall not affect (?:the )?interpretation",
