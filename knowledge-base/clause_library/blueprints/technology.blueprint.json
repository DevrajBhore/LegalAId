{
  "document_type": "SOFTWARE_DEVELOPMENT_AGREEMENT",
  "family": "technology",
  "clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "SERVICE_SCOPE_001",
    "SERVICE_DELIVERABLES_001",
    "SERVICE_TIMELINES_001",
    "SERVICE_PAYMENT_001",
    "IP_OWNERSHIP_001",
    "IP_LICENSE_001",
    "IP_LICENSE_RESTRICTIONS_001",
    "IP_COPYRIGHT_001",
    "IP_INFRINGEMENT_001",
    "IP_FEEDBACK_001",
    "TECH_ACCEPTANCE_001",
    "TECH_SOURCE_CODE_001",
    "TECH_WARRANTY_001",
    "CORE_CONFIDENTIALITY_001",
    "CORE_TERM_001",
    "CORE_TERMINATION_001",
    "CORE_LIMITATION_LIABILITY_001",
    "CORE_FORCE_MAJEURE_001",
    "CORE_SEVERABILITY_001",
    "CORE_NOTICE_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "conditional_clauses": [
    {
      "clause": "CORE_DEFINITIONS_001",
      "include_if": "include_nomenclature_clause == true"
    },
    {
      "clause": "CORE_INDEMNITY_001",
      "include_if": "include_indemnity_clause == true"
    },
    {
      "clause": "CORE_DATA_PROCESSING_001",
      "include_if": "involves_personal_data == true"
    },
    {
      "clause": "CORE_ENTIRE_AGREEMENT_001",
      "include_if": "include_entire_agreement == true",
      "note": "Optional entire-agreement (no oral terms) clause."
    }
  ],
  "variant_clauses": [
    {
      "slot": "software_ip_ownership",
      "replaces": "IP_OWNERSHIP_001",
      "select_first_match": [
        { "clause": "IP_DEVELOPER_RETAINS_001", "when": "is_developer_ip == true" }
      ],
      "default": "IP_OWNERSHIP_001"
    }
  ]
}
