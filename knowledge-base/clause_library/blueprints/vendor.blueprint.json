{
  "document_type": "VENDOR_AGREEMENT",
  "family": "supply",
  "clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "CORE_CONTRACT_FORMATION_001",
    "CORE_DEFINITIONS_001",
    "SUPPLY_GOODS_DESCRIPTION_001",
    "SUPPLY_DELIVERY_001",
    "SUPPLY_RISK_TRANSFER_001",
    "SUPPLY_QUALITY_001",
    "SUPPLY_PAYMENT_001",
    "SUPPLY_WARRANTY_001",
    "SUPPLY_INSPECTION_001",
    "SUPPLY_REJECTION_001",
    "CORE_TERMINATION_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "conditional_clauses": [
    {
      "clause": "CORE_ENTIRE_AGREEMENT_001",
      "include_if": "include_entire_agreement == true",
      "note": "Optional entire-agreement (no oral terms) clause."
    },
    {
      "clause": "CORE_INSURANCE_001",
      "include_if": "include_insurance == true",
      "note": "Insurance covenant, added once the engagement's value or term reaches elevated exposure"
    },
    {
      "clause": "CORE_CONFIDENTIALITY_001",
      "include_if": "include_confidentiality == true",
      "note": "The vendor agreement carried no confidentiality clause at all. Included when the user says they are protecting commercial information."
    },
    {
      "clause": "SUPPLY_SHORTAGE_001",
      "include_if": "include_delivery_terms == true",
      "note": "Shortage and short-delivery claims. Included when the user's stated risk is late or missed delivery."
    },
    {
      "clause": "SUPPLY_RETURN_POLICY_001",
      "include_if": "return_policy_required == true",
      "note": "Return mechanics, included when the user's stated risk is defective or non-conforming goods."
    },
    {
      "clause": "SUPPLY_PRICE_REVISION_001",
      "include_if": "include_price_revision == true",
      "note": "Indexed price-revision mechanism, included when the user's stated risk is price increases."
    },
    {
      "clause": "CORE_INDEMNITY_001",
      "include_if": "include_indemnity_clause == true",
      "note": "Included when the user's stated risk is third-party or regulatory claims."
    },
    {
      "clause": "CORE_TRANSITION_ASSISTANCE_001",
      "include_if": "include_transition_assistance == true",
      "note": "Handover on exit, included when the user's stated risk is the vendor walking away."
    }
  ]
}