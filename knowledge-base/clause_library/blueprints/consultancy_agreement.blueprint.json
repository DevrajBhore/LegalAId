{
  "document_type": "CONSULTANCY_AGREEMENT",
  "family": "service",
  "clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "SERVICE_SCOPE_001",
    "SERVICE_PAYMENT_001",
    "CORE_TERM_001",
    "SERVICE_TERMINATION_001",
    "CORE_CONFIDENTIALITY_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "required_clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "SERVICE_SCOPE_001",
    "SERVICE_PAYMENT_001",
    "CORE_TERM_001",
    "SERVICE_TERMINATION_001",
    "CORE_CONFIDENTIALITY_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "version": "3.0",
  "conditional_clauses": [
    {
      "clause": "SERVICE_DELIVERABLES_001",
      "include_if": "include_deliverables == true"
    },
    {
      "clause": "CORE_DEFINITIONS_001",
      "include_if": "include_nomenclature_clause == true"
    },
    {
      "clause": "SERVICE_WARRANTY_001",
      "include_if": "include_warranty_clause == true"
    },
    {
      "clause": "CORE_INDEMNITY_001",
      "include_if": "include_indemnity_clause == true"
    },
    {
      "clause": "CORE_LIMITATION_LIABILITY_001",
      "include_if": "include_indemnity_clause == true"
    },
    {
      "clause": "SERVICE_SLA_001",
      "include_if": "include_sla == true"
    },
    {
      "clause": "EMP_NON_SOLICITATION_001",
      "include_if": "include_non_solicit == true"
    },
    {
      "clause": "CORE_DATA_PROCESSING_001",
      "include_if": "processes_personal_data == true"
    },
    {
      "clause": "CORE_ENTIRE_AGREEMENT_001",
      "include_if": "include_entire_agreement == true",
      "note": "Optional entire-agreement (no oral terms) clause."
    },
    {
      "clause": "CORE_INSURANCE_001",
      "include_if": "include_insurance == true",
      "note": "Insurance covenant, added once the engagement's value or term reaches elevated exposure"
    }
  ],
  "mandatory_legal_checks": [
    "TDS under S.194J (10%) applies to professional/consulting fees — address in payment clause",
    "GST at 18% on consulting services — invoice compliance required",
    "Copyright Act S.19 — IP assignment must be in writing",
    "Independent contractor clause critical — EPF/ESI reclassification risk"
  ],
  "variant_clauses": [
    {
      "slot": "payment_structure",
      "replaces": "SERVICE_PAYMENT_001",
      "note": "How the engagement is billed. SERVICE_PAYMENT_001 points at a fee schedule; these state the actual mechanics, which is what a dispute turns on.",
      "select_first_match": [
        {
          "clause": "SERVICE_PAYMENT_RETAINER_001",
          "when": "is_retainer_engagement == true"
        },
        {
          "clause": "SERVICE_PAYMENT_MILESTONE_001",
          "when": "is_milestone_engagement == true"
        },
        {
          "clause": "SERVICE_PAYMENT_FIXED_FEE_001",
          "when": "is_fixed_fee_engagement == true"
        }
      ],
      "default": "SERVICE_PAYMENT_001"
    }
  ]
}
