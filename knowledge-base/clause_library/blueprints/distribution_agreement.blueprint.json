{
  "document_type": "DISTRIBUTION_AGREEMENT",
  "family": "commercial",
  "clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "DIST_APPOINTMENT_001",
    "SUPPLY_GOODS_DESCRIPTION_001",
    "SERVICE_PAYMENT_001",
    "IP_TRADEMARK_USAGE_001",
    "CORE_CONFIDENTIALITY_001",
    "CORE_TERM_001",
    "SERVICE_TERMINATION_001",
    "CORE_FORCE_MAJEURE_001",
    "CORE_INDEMNITY_001",
    "CORE_SEVERABILITY_001",
    "CORE_NOTICE_001",
    "CORE_ASSIGNMENT_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_WAIVER_001",
    "CORE_COUNTERPARTS_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "required_clauses": [
    "CORE_IDENTITY_001",
    "CORE_PURPOSE_001",
    "DIST_APPOINTMENT_001",
    "SUPPLY_GOODS_DESCRIPTION_001",
    "SERVICE_PAYMENT_001",
    "IP_TRADEMARK_USAGE_001",
    "CORE_CONFIDENTIALITY_001",
    "CORE_TERM_001",
    "SERVICE_TERMINATION_001",
    "CORE_FORCE_MAJEURE_001",
    "CORE_INDEMNITY_001",
    "CORE_SEVERABILITY_001",
    "CORE_NOTICE_001",
    "CORE_ASSIGNMENT_001",
    "CORE_DISPUTE_RESOLUTION_001",
    "CORE_GOVERNING_LAW_001",
    "CORE_WAIVER_001",
    "CORE_COUNTERPARTS_001",
    "CORE_SIGNATURE_BLOCK_001"
  ],
  "version": "3.0",
  "conditional_clauses": [
    {
      "clause": "DIST_COMPETITION_COMPLIANCE_001",
      "include_if": "include_competition_compliance == true",
      "note": "Competition Act 2002 compliance — added for exclusive/sole appointments (RPM, AAEC, foreclosure)."
    },
    {
      "clause": "SERVICE_REPORTING_001",
      "include_if": "reporting_required == true"
    },
    {
      "clause": "CORE_DATA_PROCESSING_001",
      "include_if": "involves_personal_data == true"
    },
    {
      "clause": "CORE_ENTIRE_AGREEMENT_001",
      "include_if": "include_entire_agreement == true",
      "note": "Optional entire-agreement (no oral terms) clause."
    },
    {
      "clause": "CORE_INSURANCE_001",
      "include_if": "include_insurance == true",
      "note": "Insurance covenant, added once the engagement's value or term reaches elevated exposure"
    }
  ],
  "variant_clauses": [
    {
      "slot": "distribution_exclusivity",
      "replaces": "DIST_APPOINTMENT_001",
      "select_first_match": [
        {
          "clause": "DIST_APPOINTMENT_EXCLUSIVE_001",
          "when": "is_exclusive_distribution == true"
        },
        {
          "clause": "DIST_APPOINTMENT_SOLE_001",
          "when": "is_sole_distribution == true"
        }
      ],
      "default": "DIST_APPOINTMENT_001"
    }
  ],
  "mandatory_legal_checks": [
    "Competition Act 2002 S.3(4) — exclusive distribution may be anti-competitive if appreciable adverse effect on competition (AAEC test)",
    "FEMA — distributor agreement with foreign principal requires compliance with FEMA and RBI guidelines on royalties",
    "TDS on commission payments — S.194H (5% TDS on commission)",
    "GST on distributor margin — must be properly documented"
  ]
}
