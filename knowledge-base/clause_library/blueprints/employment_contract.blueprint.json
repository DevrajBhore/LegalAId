  "_notes": "Hardened: added CORE_COMPLIANCE_WITH_LAW_001, removed duplicate EMPLOYMENT_TERMINATION_001/EMP_TERMINATION_001, added conditional clauses. v3.1: moved non-compete/non-solicitation out of required (now opt-in conditionals), added context-driven moonlighting & garden-leave clauses.",
  "conditional_clauses": [
    {
      "clause": "EMP_NON_COMPETE_001",
      "include_if": "include_non_compete == true",
      "note": "Post-employment non-compete — enforceable in India only if narrowly tied to confidential information."
    },
    {
      "clause": "EMP_NON_SOLICITATION_001",
      "include_if": "include_non_solicit == true",
      "note": "Non-solicitation of clients and employees — independently selectable (more enforceable in India than a post-term non-compete)."
    },
    {
      "clause": "EMP_MOONLIGHTING_001",
      "include_if": "restrict_moonlighting == true",
      "note": "Exclusivity / dual-employment restriction for senior roles or sensitive IP."
    },
    {
      "clause": "EMP_GARDEN_LEAVE_001",
      "include_if": "is_senior_employee == true",
      "note": "Garden leave during notice for senior / leadership roles."
    },
    {
      "clause": "CORE_ENTIRE_AGREEMENT_001",
      "include_if": "include_entire_agreement == true",
      "note": "Entire-agreement (no oral terms) clause."
    },
    {
      "clause": "CORE_DATA_PROCESSING_001",
      "include_if": "involves_personal_data == true",
      "note": "Employee handling personal data triggers DPDP-aligned obligations."
    },
    {
      "clause": "EMP_MATERNITY_BENEFITS_001",
      "include_if": "is_female_employee == true",
      "note": "Maternity benefits apply to female employees under the Maternity Benefit Act."
    },
    {
      "clause": "EMP_POSH_POLICY_001",
      "include_if": "employer_headcount_ge_10 == true",
      "note": "POSH policy + Internal Committee mandatory for workplaces with 10+ employees."
    },
    {
      "clause": "EMP_ESOP_001",
      "include_if": "has_esop_or_variable_pay == true",
      "note": "Senior/leadership and many startup hires have ESOPs / variable pay needing a dedicated, tax-aware clause."
    },
    {
      "clause": "EMP_FIXED_TERM_001",
      "include_if": "is_fixed_term == true",
      "note": "Fixed-term employment changes term, non-renewal treatment, and grants pro-rata gratuity under the IR Code / IESO Rules 2018."
    }
  ],
